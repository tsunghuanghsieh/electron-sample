        "babel-core": "^6.23.0",
        "babel-loader": "^8.0.6",
        "babel-preset-env": "^0.0.0",
        "clean-webpack-plugin": "^4.0.0",
        "css-loader": "^7.1.4",
        "electron": "41.1.1",
        "electron-builder": "26.8.1",
        "html-webpack-plugin": "^5.6.6",
        "less": "^3.9.0",
        "style-loader": "^4.0.0",
        "webpack": "^5.105.4"
    },
    "dependencies": {
        "es6-module-transpiler": "^0.10.0",
        "material-ui": "^0.20.0",
        "react": "^15.4.0",
        "react-dom": "^15.4.0",
